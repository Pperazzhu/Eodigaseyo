<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 신호 대기로 멈췄는지(속도 ≈ 0) 확인. 정차 중 처음 한 번 설명 후 물어봐요 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 출발 알림: 앱이 화면에 없을 때 시스템 알림으로 알려줘요 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eodigaseyo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 쓸 수 있는 화면이라는 표시 (주행 중엔 레이더·묻기를 앱이 직접 숨김) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <receiver android:name=".DepartReceiver" android:exported="false" />
    </application>

</manifest>